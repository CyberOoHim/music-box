# =================================================================
# Mechanical Music Box - Environment Configuration
# =================================================================

# Google Gemini API Key for AI Music Box Composer
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Passcode to protect the AI Composer Gemini LLM API access
# If set, users must enter this passcode in the AI Composer modal to compose melodies.
# Leave blank to allow unauthenticated access when GEMINI_API_KEY is configured.
AI_COMPOSER_PASSCODE=

# Server Port (default: 3000)
PORT=3000

# Environment Mode ('development' or 'production')
NODE_ENV=development
